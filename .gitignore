/target
**/*.rs.bk
*.pdb

# Local runtime state — never commit
/run/
/data/
*.sqlite
*.sqlite-*
*.redb

# Local config with real upstreams/keys
/alpendns.toml
/config/local.*.toml
/config/*.dev.txt
*.pem
*.key

# Blocklist caches
/lists/

# Web UI build output
/web/node_modules/
/web/dist/

# Editor-Artefakte. Ein `git add -A` sammelt sonst die Swap-Datei einer gerade
# geöffneten Konfiguration ein — genau das ist passiert.
*.swp
*.swo
*~
.*.swp

.DS_Store

# cargo-fuzz
/crates/*/fuzz/target/
/crates/*/fuzz/artifacts/
# Von libFuzzer erzeugt; kuratierte Eingaben liegen in fuzz/seeds/
/crates/*/fuzz/corpus/
/crates/*/fuzz/coverage/

# Messkorpora für die Heuristiken (Phase 8). Nicht im Repo: fremde Daten,
# ein bis zwei Megabyte, und für den Bau nicht nötig — gebraucht werden sie
# nur von den --ignored-Messläufen in tests/detect_corpus.rs. Woher sie
# kommen, steht in docs/TESTING.md.
/corpus/
