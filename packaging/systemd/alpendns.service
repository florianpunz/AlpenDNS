# AlpenDNS als Systemdienst.
#
# Zwei Dinge, die hier anders sind als in den meisten Beispielen im Netz:
#
#   * Port 53 kommt über AmbientCapabilities, nicht über root. Der Prozess
#     startet direkt als `alpendns` und war nie privilegiert (CLAUDE.md B.5).
#   * ExecStartPre prüft die Konfiguration. Ist sie kaputt, startet der neue
#     Prozess gar nicht erst — bei `systemctl restart` bedeutet das: der Dienst
#     bleibt unten und sagt warum, statt in einer Neustartschleife zu landen.
#
# Was die Hardening-Direktiven bewirken, steht in docs/OPERATIONS.md.
# Nachrechnen: systemd-analyze security alpendns

[Unit]
Description=AlpenDNS — privacy-fokussierter DNS-Resolver
Documentation=file:///usr/share/doc/alpendns/OPERATIONS.md
Documentation=https://github.com/florianpunz/alpendns
# Blocklisten werden beim ersten Start heruntergeladen; ohne Netz bricht
# dieser erste Start ab (fail closed, CLAUDE.md B.1 Regel 6).
After=network-online.target
Wants=network-online.target
# Ein Resolver, der beim Start dauerhaft scheitert, soll auffallen und nicht
# alle zwei Sekunden das Journal füllen. Die beiden Schlüssel gehören nach
# [Unit], obwohl sie das Restart= aus [Service] begrenzen.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=alpendns
Group=alpendns
ExecStartPre=/usr/bin/alpendns -c /etc/alpendns/alpendns.toml check
ExecStart=/usr/bin/alpendns -c /etc/alpendns/alpendns.toml
# SIGTERM beantwortet der Prozess selbst: laufende Anfragen werden noch
# beantwortet, dann Exit 0. Deshalb kein KillMode-Kunststück.
KillSignal=SIGTERM
TimeoutStopSec=10s
Restart=on-failure
RestartSec=2s
# --- Rechte -----------------------------------------------------------------
# Die einzige Fähigkeit, die der Dienst braucht: an Port 53 binden.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
UMask=0077

# --- Verzeichnisse ----------------------------------------------------------
# Von systemd angelegt und dem Dienstuser übereignet. Damit muss das Paket
# keine Rechte setzen, und ein Upgrade kann sie nicht kaputtmachen.
StateDirectory=alpendns
StateDirectoryMode=0750
CacheDirectory=alpendns
CacheDirectoryMode=0750
LogsDirectory=alpendns
LogsDirectoryMode=0750

# --- Dateisystem ------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# AF_NETLINK steht hier, obwohl CLAUDE.md B.5 nur die drei anderen nennt:
# glibc fragt beim Auflösen eines Hostnamens (Blocklisten-Download) über
# Netlink ab, welche Adressfamilien die Maschine überhaupt hat. Ohne die Zeile
# schlägt der Listen-Download auf manchen Systemen fehl, und zwar still.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
