# Rotation for the query log. Only in effect with privacy.logging.mode = "full" —
# in every other mode the file is not created at all, and `missingok` lets the
# rule pass through silently.
#
# The number below is the retention period of the names, and it is the only
# privacy decision this system does not make itself: "rotate 7" with "daily"
# means seven days of names on disk. Whoever wants less changes the number
# here; the file is a conffile, so an upgrade will not overwrite it.
#
# copytruncate is the heart of it. AlpenDNS keeps the file open with O_APPEND
# permanently and never reopens it — the normal case (move the file, create a
# new one) would leave the service writing into the moved file until someone
# restarts it. copytruncate copies instead and truncates the original back to
# zero; with O_APPEND the next write lands at the beginning again. The price is
# a window of milliseconds in which lines can be lost — tolerable for a query
# log, and the price for needing no reopen signal in the code.
#
# su stands here deliberately not: the default from /etc/logrotate.conf (root on
# Debian) may read and truncate the file, and a hard-coded user name would break
# as soon as someone renames the service user.

/var/log/alpendns/queries.jsonl {
	daily
	rotate 7
	maxsize 100M
	compress
	delaycompress
	copytruncate
	missingok
	notifempty
}
